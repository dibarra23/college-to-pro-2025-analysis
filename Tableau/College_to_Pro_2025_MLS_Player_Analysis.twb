      <aliases enabled='yes' />
      <column caption='Final Outcome' datatype='string' name='[Calculation_4643351984032301056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF STARTSWITH([Outcome Category], &quot;Pro -&quot;) THEN &quot;Pro&quot;&#10;ELSEIF [Outcome Category] = &quot;Returned to College&quot; THEN &quot;Returned to College&quot;&#10;ELSEIF [Outcome Category] = &quot;Amateur / Pre-Professional&quot; THEN &quot;Amateur / Pre-Professional&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
      </column>
      <column caption='Pro Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4643351984035246081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4643351984032301056] = &quot;Pro&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Position Clean' datatype='string' name='[Calculation_4643351984036331522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Position] = &quot;CM&quot; THEN &quot;M&quot;&#10;ELSE [Position]&#10;END' />
      </column>
      <column caption='MLS Outcome' datatype='string' name='[Calculation_4643351984040218627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Outcome Category] = &quot;Pro - MLS&quot; THEN &quot;Reached MLS&quot;&#10;ELSE &quot;Did Not Reach MLS&quot;&#10;END' />
      </column>
      <column caption='Academy Background' datatype='string' name='[Calculation_4643351984042659844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([MLS NEXT Academy]) OR TRIM([MLS NEXT Academy]) = &quot;&quot; THEN &quot;No MLS Academy&quot;&#10;ELSE &quot;MLS Academy&quot;&#10;END' />
      </column>
      <column caption='Resolved Pro Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4686839867948396544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4643351984032301056] != &quot;Unknown&quot; THEN [Calculation_4643351984035246081]&#10;END' />
      </column>
      <column caption='Draft Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4686839867948990465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Drafted?] = &quot;Yes&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_4698098867029090304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Draft Rate' datatype='real' default-format='p0.0%' name='[Calculation_4828843993758760960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_4686839867948990465])' />
      </column>
      <column caption='MLS Reach Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4828843993765244929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4643351984040218627] = &quot;Reached MLS&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column datatype='string' name='[Drafted?]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;No&quot;' value='Not Drafted' />
          <alias key='&quot;Yes&quot;' value='Drafted' />
        </aliases>
      </column>
      <column datatype='string' name='[Outcome Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[Position]' role='dimension' type='nominal' />
