  <worksheets>
    <worksheet name='Did Being Drafted Increase the Chance of Reaching MLS?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Did Being Drafted Increase the Chance of Reaching MLS?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Drafted players were much more likely to reach MLS. 11 of 90 drafted players (12.2%) reached MLS, compared with just 1 of 346 undrafted players (0.3%)</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Eligible_Players_2026 (MLS_2026_College_to_Pro_Working_Dataset1)' name='federated.14ip1ec0divs141dgcd0p19et6m2' />
          </datasources>
          <datasource-dependencies datasource='federated.14ip1ec0divs141dgcd0p19et6m2'>
            <column caption='MLS Outcome' datatype='string' name='[Calculation_4643351984040218627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Outcome Category] = &quot;Pro - MLS&quot; THEN &quot;Reached MLS&quot;&#10;ELSE &quot;Did Not Reach MLS&quot;&#10;END' />
            </column>
            <column caption='MLS Reach Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4828843993765244929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4643351984040218627] = &quot;Reached MLS&quot; THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column datatype='string' name='[Drafted?]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;No&quot;' value='Not Drafted' />
                <alias key='&quot;Yes&quot;' value='Drafted' />
              </aliases>
            </column>
            <column datatype='string' name='[Outcome Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4828843993765244929]' derivation='Avg' name='[avg:Calculation_4828843993765244929:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Drafted?]' derivation='None' name='[none:Drafted?:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
