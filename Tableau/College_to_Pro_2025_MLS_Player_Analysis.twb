    <worksheet name='Does an MLS Academy Background Increase the Chance of Turning Pro?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Does an MLS Academy Background Increase the Chance of Turning Pro?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Yes, but only slightly and the difference is small enough that it could just be random chance rather than a real effect.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Eligible_Players_2026 (MLS_2026_College_to_Pro_Working_Dataset1)' name='federated.14ip1ec0divs141dgcd0p19et6m2' />
          </datasources>
          <datasource-dependencies datasource='federated.14ip1ec0divs141dgcd0p19et6m2'>
            <column caption='Final Outcome' datatype='string' name='[Calculation_4643351984032301056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([Outcome Category], &quot;Pro -&quot;) THEN &quot;Pro&quot;&#10;ELSEIF [Outcome Category] = &quot;Returned to College&quot; THEN &quot;Returned to College&quot;&#10;ELSEIF [Outcome Category] = &quot;Amateur / Pre-Professional&quot; THEN &quot;Amateur / Pre-Professional&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
            </column>
            <column caption='Pro Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4643351984035246081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4643351984032301056] = &quot;Pro&quot; THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Academy Background' datatype='string' name='[Calculation_4643351984042659844]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([MLS NEXT Academy]) OR TRIM([MLS NEXT Academy]) = &quot;&quot; THEN &quot;No MLS Academy&quot;&#10;ELSE &quot;MLS Academy&quot;&#10;END' />
            </column>
            <column caption='Resolved Pro Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4686839867948396544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4643351984032301056] != &quot;Unknown&quot; THEN [Calculation_4643351984035246081]&#10;END' />
            </column>
            <column datatype='string' name='[MLS NEXT Academy]' role='dimension' type='nominal' />
            <column datatype='string' name='[Outcome Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4686839867948396544]' derivation='Avg' name='[avg:Calculation_4686839867948396544:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4643351984042659844]' derivation='None' name='[none:Calculation_4643351984042659844:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.14ip1ec0divs141dgcd0p19et6m2].[avg:Calculation_4686839867948396544:qk]' scope='cols' value='Pro Conversion Rate' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='height' field='[federated.14ip1ec0divs141dgcd0p19et6m2].[none:Calculation_4643351984042659844:nk]' value='74' />
