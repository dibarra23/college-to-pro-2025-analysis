    <worksheet name='What Happened to Players Selected in the MLS SuperDraft?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>What Happened to Players Selected in the MLS SuperDraft?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Being drafted did not guarantee an immediate move to the pros. Of 90 drafted players, 50 entered a professional league, while 36 returned to college and 4 remained unresolved.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Eligible_Players_2026 (MLS_2026_College_to_Pro_Working_Dataset1)' name='federated.14ip1ec0divs141dgcd0p19et6m2' />
