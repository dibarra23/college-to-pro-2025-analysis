            </column>
            <column datatype='string' name='[Outcome Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Player]' role='dimension' type='nominal' />
            <column-instance column='[Player]' derivation='CountD' name='[ctd:Player:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Drafted?]' derivation='None' name='[none:Drafted?:nk]' pivot='key' type='nominal' />
            <column-instance column='[Outcome Category]' derivation='None' name='[none:Outcome Category:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.14ip1ec0divs141dgcd0p19et6m2].[none:Drafted?:nk]'>
            <groupfilter function='member' level='[none:Drafted?:nk]' member='&quot;Yes&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.14ip1ec0divs141dgcd0p19et6m2].[none:Drafted?:nk]</column>
