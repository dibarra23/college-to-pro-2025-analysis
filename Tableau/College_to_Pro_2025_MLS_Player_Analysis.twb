    <worksheet name='How Many Eligible Players Were Drafted?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>How Many Eligible Players Were Drafted?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Only 90 of 436 eligible players were selected in the MLS SuperDraft, a draft rate of 20.6%.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Eligible_Players_2026 (MLS_2026_College_to_Pro_Working_Dataset1)' name='federated.14ip1ec0divs141dgcd0p19et6m2' />
          </datasources>
          <datasource-dependencies datasource='federated.14ip1ec0divs141dgcd0p19et6m2'>
            <column caption='Draft Flag' datatype='integer' default-format='p0.0%' name='[Calculation_4686839867948990465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Drafted?] = &quot;Yes&quot; THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Draft Rate' datatype='real' default-format='p0.0%' name='[Calculation_4828843993758760960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_4686839867948990465])' />
            </column>
            <column datatype='string' name='[Drafted?]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;No&quot;' value='Not Drafted' />
                <alias key='&quot;Yes&quot;' value='Drafted' />
              </aliases>
            </column>
            <column-instance column='[Calculation_4828843993758760960]' derivation='User' name='[usr:Calculation_4828843993758760960:qk]' pivot='key' type='quantitative' />
