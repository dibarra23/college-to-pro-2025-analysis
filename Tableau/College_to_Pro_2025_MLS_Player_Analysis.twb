    <worksheet name='What Happened to the 2025 Eligible Player Pool?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>What Happened to the 2025 Eligible Player Pool?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Most eligible players either returned to college (179) or had an unresolved outcome (151), while 104 were confirmed in a professional pathway.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Eligible_Players_2026 (MLS_2026_College_to_Pro_Working_Dataset1)' name='federated.14ip1ec0divs141dgcd0p19et6m2' />
          </datasources>
