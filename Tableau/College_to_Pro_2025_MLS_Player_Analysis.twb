    <worksheet name='How Likely Was an Eligible 2025 College Player to Reach MLS?'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>How Likely Was an Eligible 2025 College Player to Reach MLS?</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Only 2.75% of eligible college players reached MLS, showing how difficult the jump from college to the league is.</run>
          </formatted-text>
        </caption>
